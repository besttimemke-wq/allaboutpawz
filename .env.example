# ============================================================================
# All About Pawz — Environment
# ============================================================================
# Architecture:
#   - Supabase is the ONLY backend (47 tables, auth, storage, realtime).
#   - No local database, no fallback. All data lives in Supabase.
#
# The site renders even with these unset (reads return empty data), so a
# fresh clone boots without configuration. Fill in real values for full
# functionality, then restart the dev server.
# ============================================================================

# --- Supabase (the backend) ---
# Get these from: Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_ prefix = available in both browser and server.
# No NEXT_PUBLIC_ prefix = server-only (never exposed to browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only aliases (same values, read by the API routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=sk_live_or_test_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- Site (canonical domain for Stripe callbacks + emails) ---
NEXT_PUBLIC_SITE_URL=https://aapawz.com

# --- Resend (transactional email) ---
# Used for booking confirmations, consultation notifications, payment receipts.
RESEND_API_KEY=re_your_key
EMAIL_FROM="All About Pawz <notifications@yourdomain.com>"
SALON_NOTIFY_EMAIL=notifications@yourdomain.com

# --- Admin access ---
# Comma-separated list of emails that get admin role on sign-in.
ADMIN_EMAILS=admin@yourdomain.com
