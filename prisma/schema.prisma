// Prisma schema — Digital Learning University (Leashed Learning Framework)
// Course data model: the canonical Pathway JSON is persisted on Course.data
// so duplication is a deep-clone + new code. Structured tables handle the
// runtime concerns (enrollments, progress, live AI tutor sessions, quiz attempts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Course {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "LSH"
  title           String
  subtitle        String
  description     String
  missionAlignment String
  totalHours      Int // 120
  ceus            Float // 12.0
  scormPackageId  String
  accreditation   String // JSON string array e.g. ["COE","ACCSC","IACET","ICG","SCORM"]
  status          String   @default("published") // draft | published
  aiGenerated     Boolean  @default(false)
  data            String // JSON-serialized full Pathway object (levels/modules/lessons/quizzes/rubrics)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments  Enrollment[]
  chatSessions ChatSession[]
  quizAttempts QuizAttempt[]
  reviews      Review[]
  sources      CourseSource[]
}

model Learner {
  id          String   @id @default(cuid())
  name        String   @unique
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]

  // ── 13-step enrollment intake (stored as JSON, updated progressively) ──
  intake      String   @default("{}") // JSON: all 13 steps of intake data
  intakeStep  Int      @default(0) // 0 = not started, 13 = complete
  intakeComplete Boolean @default(false)

  // ── Referral / partner verification (step 3) ──
  partnerId   String?  // links to Partner if enrolled via referral
  partner     Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  // ── Support team assignment ──
  supportTeamAssignments SupportTeamAssignment[]
}

/// A referring partner organization (salon, nonprofit, workforce board, reentry program)
model Partner {
  id              String   @id @default(cuid())
  code            String   @unique // the "partner number / referral code"
  name            String   // org name
  type            String   // salon | nonprofit | workforce-board | reentry-program | community-org
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  learners        Learner[]
}

/// Support team members — case managers, academic advisors, mentors
model SupportStaff {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  role            String   // case-manager | academic-advisor | mentor | instructor
  specialties     String?  // JSON array: ["reentry", "pet-grooming", "financial-literacy"]
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  caseManagerAssignments  SupportTeamAssignment[] @relation("CaseManagerAssign")
  advisorAssignments      SupportTeamAssignment[] @relation("AdvisorAssign")
  mentorAssignments       SupportTeamAssignment[] @relation("MentorAssign")
}

/// Links a learner to their support team members
model SupportTeamAssignment {
  id              String   @id @default(cuid())
  learnerId        String  @unique // one support team per learner
  learner          Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  caseManagerId   String?
  academicAdvisorId String?
  mentorId        String?
  caseManager     SupportStaff? @relation("CaseManagerAssign", fields: [caseManagerId], references: [id], onDelete: SetNull)
  academicAdvisor SupportStaff? @relation("AdvisorAssign", fields: [academicAdvisorId], references: [id], onDelete: SetNull)
  mentor          SupportStaff? @relation("MentorAssign", fields: [mentorId], references: [id], onDelete: SetNull)
  assignedAt      DateTime @default(now())
}

model CourseSource {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  filename    String
  fileType    String // pdf | docx | txt | md
  textContent String // extracted raw text — the AI's reference material
  uploadedAt  DateTime @default(now())

  @@index([courseId])
}

model Enrollment {
  id          String   @id @default(cuid())
  learnerName String // lightweight learner identity (MVP — no auth)
  learnerEmail String?
  learnerId   String?
  learner     Learner? @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    String   @default("{}") // JSON: { [moduleCode]: { completedClasses: string[], quizScore?: number, quizPassed?: boolean } }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
}

model ChatSession {
  id         String   @id @default(cuid())
  courseId    String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleCode String?
  learnerName String?
  createdAt  DateTime @default(now())
  messages   ChatMessage[]

  @@index([courseId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant | system
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  courseId    String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleCode String
  learnerName String?
  score      Int // percentage 0-100
  passed     Boolean
  answers    String // JSON: [{ question, selected, correct }]
  createdAt  DateTime @default(now())

  @@index([courseId])
}

model Review {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learnerName String
  rating      Int // 1-5 stars
  title       String
  body        String
  createdAt   DateTime @default(now())

  @@index([courseId])
}
