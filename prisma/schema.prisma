// UNLEASHED Classroom — Prisma schema (SQLite)
// Ported from the original node:sqlite schema in lib/db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Courses & curriculum companions ----

model Course {
  id            Int      @id @default(autoincrement())
  ownerId       String
  state         String
  area          String
  statute       String
  grade         String
  title         String
  companionJson String
  model         String
  createdAt     DateTime @default(now())

  professorMessages      ProfessorMessage[]
  notes                  LearnerNote[]
  events                 LearnerEvent[]
  files                  LearnerFile[]
  assignmentStates       LearnerAssignmentState[]
  evidence               LearnerEvidence[]
  learningDays           LearningDay[]
  attempts               LearningAttempt[]
  humanNeeds             HumanNeedQueue[]
  enrollments            CourseEnrollment[]
  scheduleBlocks         SchoolScheduleBlock[]
  gradebookEntries       GradebookEntry[]
  meetings               ClassroomMeeting[]

  @@index([ownerId, createdAt(sort: Desc)])
}

model ProfessorMessage {
  id        Int      @id @default(autoincrement())
  ownerId   String
  courseId  Int
  role      String // 'learner' | 'professor'
  content   String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([ownerId, courseId, id])
}

model DashboardProfessorMessage {
  id        Int      @id @default(autoincrement())
  ownerId   String
  lessonId  String
  role      String // 'learner' | 'professor'
  content   String
  createdAt DateTime @default(now())

  @@index([ownerId, lessonId, id])
}

// ---- Workspace (notes, events, files, messages, evidence) ----

model LearnerNote {
  id        Int       @id @default(autoincrement())
  ownerId   String
  courseId  Int?
  title     String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([ownerId, updatedAt(sort: Desc)])
}

model LearnerEvent {
  id        Int      @id @default(autoincrement())
  ownerId   String
  courseId  Int?
  title     String
  startsAt  String
  kind      String
  createdAt DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([ownerId, startsAt])
}

model LearnerFile {
  id        Int      @id @default(autoincrement())
  ownerId   String
  courseId  Int?
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt(sort: Desc)])
}

model LearnerAssignmentState {
  ownerId       String
  courseId      Int
  assignmentKey String
  status        String
  score         Float?
  updatedAt     DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([ownerId, courseId, assignmentKey])
}

model LearnerMessage {
  id        Int      @id @default(autoincrement())
  ownerId   String
  sender    String
  recipient String
  content   String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

model LearnerEvidence {
  id        Int      @id @default(autoincrement())
  ownerId   String
  courseId  Int
  kind      String
  title     String
  content   String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt(sort: Desc)])
}

// ---- Governed learning Day + append-only event projection ----

model LearningDay {
  id               Int       @id @default(autoincrement())
  ownerId          String
  courseId         Int
  mode             String    // 'SPRINT' | 'SHIFT' | 'FULL_DAY'
  state            String
  currentLesson    Int       @default(0)
  currentItem      String    @default("")
  cycleStep        Int       @default(0)
  sentiment        String?
  openedAt         DateTime
  scheduledCloseAt DateTime
  breakEndsAt      DateTime?
  priorState       String?
  closedAt         DateTime?
  recap            String?
  homework         String?
  forecast         String?
  version          Int       @default(1)
  updatedAt        DateTime  @updatedAt
  // active-work projection (added via ALTER in original)
  activeWorkKind   String    @default("LESSON")
  activeWorkKey    String?
  activeWorkTitle  String?

  course  Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  events  LearningDayEvent[]
  attempts LearningAttempt[]
  queue   HumanNeedQueue[]

  @@index([ownerId, courseId])
}

model LearningDayEvent {
  id          Int      @id @default(autoincrement())
  ownerId     String
  dayId       Int
  eventType   String
  payloadJson String
  createdAt   DateTime @default(now())

  day LearningDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([ownerId, dayId, id])
}

model LearningAttempt {
  id              Int      @id @default(autoincrement())
  ownerId         String
  dayId           Int
  courseId        Int
  lessonIndex     Int
  itemText        String
  attemptNo       Int
  response        String
  score           Float
  passed          Boolean
  stage           String
  misconception   String   @default("")
  feedback        String   @default("")
  evidenceSummary String   @default("")
  workKind        String   @default("LESSON")
  workKey         String?
  createdAt       DateTime @default(now())

  day    LearningDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([ownerId, dayId, id])
}

model HumanNeedQueue {
  id          Int       @id @default(autoincrement())
  ownerId     String
  dayId       Int
  courseId    Int
  reason      String
  status      String    @default("OPEN")
  contextJson String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  day    LearningDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, createdAt])
}

// ---- Multi-course school Day projection ----

model CourseEnrollment {
  ownerId           String
  courseId          Int
  level             String   @default("Not assessed")
  deficiencyFocus   String?
  priority          String   @default("Low")
  enrolledAt        DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([ownerId, courseId])
}

model SchoolScheduleBlock {
  id               Int      @id @default(autoincrement())
  ownerId          String
  schoolDate       String
  courseId         Int?
  blockType        String
  title            String
  startsAt         String
  endsAt           String
  status           String   @default("UPCOMING")
  deficiencyFocus  String?
  sequence         Int

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([ownerId, schoolDate, sequence])
}

model GradebookEntry {
  id        Int       @id @default(autoincrement())
  ownerId   String
  courseId  Int
  title     String
  category  String
  score     Float?
  possible  Float?
  status    String
  feedback  String?
  gradedAt  DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model ClassroomMeeting {
  id        Int      @id @default(autoincrement())
  ownerId   String
  courseId  Int?
  title     String
  startsAt  String
  endsAt    String
  room      String
  status    String   @default("SCHEDULED")

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ---- RAG knowledge base (Supabase-ready) ----

model KnowledgeChunk {
  id           String   @id @default(cuid())
  ownerId      String
  sourceId     String
  pathwayCode  String
  moduleCode   String
  text         String
  safetyFlag   Boolean  @default(false)
  embedding    String?
  createdAt    DateTime @default(now())

  @@index([ownerId, pathwayCode])
  @@index([ownerId, sourceId])
}
