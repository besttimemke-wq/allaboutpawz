+    for (const p of ["admin", "groomer", "frontdesk", "customer"]) {
+      const v = mod.validatePortalAccess(p, resolved);
+      console.log(`[4] validatePortalAccess(${p}): ok=${v.ok} → ${v.redirectTo || v.error}`);
+    }
+  }
+}
