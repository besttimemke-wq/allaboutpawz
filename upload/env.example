# ============================================================================
# All About Pawz — Environment Example
# ============================================================================
# Copy this file to .env and fill in your values.
#
# Architecture:
#   - Supabase is the primary backend (47 tables, auth, storage, realtime).
#   - SQLite/Prisma is a fallback for the 12 CMS content tables only.
#   - If Supabase keys are present AND reachable, Supabase is used.
#   - If Supabase keys are absent OR unreachable, SQLite/Prisma is used.
#
# You need EITHER Supabase OR SQLite configured. Supabase is recommended
# because the app's core tables (customers, dogs, bookings, payments, staff,
# grooming data, auth, storage) only exist in Supabase.
# ============================================================================

# --- Supabase (primary backend) ---
# Get these from: Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_ prefix = available in both browser and server.
# No NEXT_PUBLIC_ prefix = server-only (never exposed to browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- SQLite/Prisma (fallback for CMS content tables) ---
# Only used if Supabase is not configured or unreachable.
DATABASE_URL=file:./db/custom.db

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=sk_live_or_test_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- Resend (transactional email) ---
# Used for booking confirmations, consultation notifications, payment receipts.
RESEND_API_KEY=re_your_key
EMAIL_FROM="All About Pawz <notifications@yourdomain.com>"
SALON_NOTIFY_EMAIL=notifications@yourdomain.com

# --- Admin access ---
# Comma-separated list of emails that get admin role on sign-in.
ADMIN_EMAILS=admin@yourdomain.com
